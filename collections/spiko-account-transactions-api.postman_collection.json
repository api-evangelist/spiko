          "item": [
            {
              "name": "Get account transaction history",
              "id": "cd273ed5-9f71-41ca-bbae-9ac60c239c68",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "basic",
                  "basic": [
                    {
                      "key": "username",
                      "value": "{{basicAuthUsername}}",
                      "type": "string"
                    },
                    {
