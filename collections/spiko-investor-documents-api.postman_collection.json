          "name": "Get investor documents",
          "request": {
            "name": "Get investor documents",
            "description": {
              "content": "\n**Retrieve all documents for an investor.**\n\n- Returns a list of documents uploaded for the specified investor.\n- Only active (non-archived) documents are returned.\n- Optionally filter by `documentTypes` (e.g. [`official-id`, `proof-of-address`, `imprime-fiscal-unique`]).\n          ",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "investor-documents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "investorId",
                  "value": "<uuid>",
                  "description": "(Required) a Universally Unique Identifier"
                },
                {
                  "disabled": false,
                  "key": "documentTypes",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "documentTypes",
                  "value": "<string>"
