{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spiko Distributor Account transactions Transfer Orders API",
    "version": "v0"
  },
  "items": [
    {
      "info": {
        "name": "Transfer Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of an investor's transfer orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://distributor-api.spiko.io/transfer-orders/",
            "params": [
              {
                "name": "investorId",
                "value": "",
                "type": "query",
                "description": "a Universally Unique Identifier"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "\nGet all transfer orders for a given investor with optional status filter.\n\n> ⚠️ **For displaying an account's activity, prefer the [account transaction history endpoint](#tag/Account-Transactions/operation/accountTransactions.getAccountTransactions).** It returns deposits, withdrawals, transfers and yield accruals as a single time-ordered stream, with cursor pagination, so you don't need to call multiple per-order-type endpoints and reconcile their results.\n"
        },
        {
          "info": {
            "name": "Create a new transfer order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://distributor-api.spiko.io/transfer-orders/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a transfer order between two accounts owned by the investor"
        },
        {
          "info": {
            "name": "Get transfer order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://distributor-api.spiko.io/transfer-orders/:transferOrderId",
            "params": [
              {
                "name": "transferOrderId",
                "value": "",
                "type": "path",
                "description": "a Universally Unique Identifier"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get info of a specific transfer order by its ID"
        }
      ]
    }
  ],
  "bundled": true
}