{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spiko Distributor Account transactions Webhook Events API",
    "version": "v0"
  },
  "items": [
    {
      "info": {
        "name": "Webhook Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Poll webhook events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://distributor-api.spiko.io/v0/webhook-events",
            "params": [
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "eventType",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "a string to be decoded into a number"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve webhook events using cursor-based pagination. Pass the last `sequenceNumber` as `after` to get the next page."
        }
      ]
    }
  ],
  "bundled": true
